# ---------------------------------------------------------------------------
# إعدادات موقع كوبونات المشرفون  |  Moshrefoon coupon site settings
# انسخ هذا الملف إلى .env ثم عدّل القيم.  |  Copy to .env and edit.
# ---------------------------------------------------------------------------

# منفذ الخادم | HTTP port
PORT=3000

# العنوان العام للموقع — يوضع داخل رمز QR، فمهم أن يكون العنوان الحقيقي
# Public base URL embedded inside every QR code. Must be the real address
# staff phones can reach, e.g. https://coupons.example.com
PUBLIC_URL=http://localhost:3000

# كلمة مرور لوحة التحكم | Admin/staff password.
# إذا تُركت فارغة يولّد النظام كلمة مرور عشوائية عند أول تشغيل ويحفظها في data/admin-password.txt
ADMIN_PASSWORD=

# مفتاح التوقيع السري — يميّز الكوبونات المولّدة من هذا الموقع عن أي كوبون مزوّر.
# HMAC signing key that proves a coupon came from this site. Keep it secret.
# إذا تُرك فارغاً يولَّد تلقائياً ويحفظ في data/secret.key
# تحذير: تغييره يُبطل توقيع كل الكوبونات القديمة.
COUPON_SECRET=

# بادئة أكواد الكوبونات | Coupon code prefix (A-Z0-9, 2-6 chars)
COUPON_PREFIX=MSH

# قيمة الخصم الافتراضية الظاهرة على الكوبون | Default discount value on the coupon
DEFAULT_AMOUNT=10

# ملف قاعدة البيانات | SQLite database file
DB_PATH=data/coupons.db

# الوضع خلف بروكسي (nginx/caddy) لضبط عناوين IP الحقيقية | Trust reverse proxy
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# ربط السجل بـ Google Sheets | Google Sheets link
# ---------------------------------------------------------------------------

# رابط تصدير للقراءة فقط محمي بمفتاح، تسحبه دالة IMPORTDATA في الجدول.
# اتركه فارغاً ليولَّد مفتاح ثابت ويحفظ في data/export.key
# A read-only, key-protected CSV endpoint a spreadsheet can pull.
EXPORT_KEY=

# اضبطها 0 لتعطيل رابط التصدير تماماً | set to 0 to disable the shared link
SHEETS_EXPORT=1

# التوقيت المعروض في ملف التصدير | time zone used for exported dates
DISPLAY_TIMEZONE=Asia/Riyadh

# ---------------------------------------------------------------------------
# النسخ الاحتياطي | Backups
# ---------------------------------------------------------------------------

# نسخة تلقائية (قاعدة البيانات + مفتاح التوقيع) في data/backups — 0 لإيقافها
# Automatic backup of the database and signing key into data/backups
BACKUP_ENABLED=1
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# نسخة خارج الموقع (اختياري) إلى أي تخزين متوافق مع S3:
# Railway Buckets أو Cloudflare R2 أو Backblaze B2 أو AWS S3.
# Optional off-site copy to any S3-compatible bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=moshrefoon-backups
