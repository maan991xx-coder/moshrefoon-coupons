# ---------------------------------------------------------------------------
# إعدادات موقع كوبونات المشرفون  |  Moshrefoon coupon site settings
# انسخ هذا الملف إلى .env ثم عدّل القيم.  |  Copy to .env and edit.
# ---------------------------------------------------------------------------

# منفذ الخادم | HTTP port
PORT=3000

# العنوان العام للموقع — يوضع داخل رمز QR، فمهم أن يكون العنوان الحقيقي
# Public base URL embedded inside every QR code. Must be the real address
# staff phones can reach, e.g. https://coupons.example.com
PUBLIC_URL=http://localhost:3000

# كلمة مرور لوحة التحكم | Admin/staff password.
# إذا تُركت فارغة يولّد النظام كلمة مرور عشوائية عند أول تشغيل ويحفظها في data/admin-password.txt
ADMIN_PASSWORD=

# مفتاح التوقيع السري — يميّز الكوبونات المولّدة من هذا الموقع عن أي كوبون مزوّر.
# HMAC signing key that proves a coupon came from this site. Keep it secret.
# إذا تُرك فارغاً يولَّد تلقائياً ويحفظ في data/secret.key
# تحذير: تغييره يُبطل توقيع كل الكوبونات القديمة.
COUPON_SECRET=

# بادئة أكواد الكوبونات | Coupon code prefix (A-Z0-9, 2-6 chars)
COUPON_PREFIX=MSH

# قيمة الخصم الافتراضية الظاهرة على الكوبون | Default discount value on the coupon
DEFAULT_AMOUNT=10

# ملف قاعدة البيانات | SQLite database file
DB_PATH=data/coupons.db

# الوضع خلف بروكسي (nginx/caddy) لضبط عناوين IP الحقيقية | Trust reverse proxy
TRUST_PROXY=0
